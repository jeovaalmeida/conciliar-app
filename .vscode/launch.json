{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (console)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/bin/Debug/net9.0/conciliar-app.dll",
            //"args": ["MASTER", "OUROCARD_MASTERCARD_INTERNATIONAL-Jan_26.txt", "2026-01", ""],
            //"args": ["MASTER", "OUROCARD_MASTERCARD_INTERNATIONAL-Próxima_Fatura.txt", "2026-02", ""],
            //"args": ["VISA", "OUROCARD_VISA_INTERNATIONAL-Jan_26.txt", "2026-01", ""],
            "args": ["VISA", "OUROCARD_VISA_INTERNATIONAL-Próxima_Fatura.txt", "2026-02", ""], // "INSERIR"],
            "cwd": "${workspaceFolder}/src",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "internalConsoleOptions": "openOnSessionStart",
            "launchBrowser": {
                "enabled": false
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        }
    ]
}